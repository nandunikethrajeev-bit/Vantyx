# VANTYX Environment Configuration
# Copy this file to .env and adjust values for local development.

# Application
PROJECT_NAME="VANTYX"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"

# API & Networking
API_V1_PREFIX="/api/v1"
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
FRONTEND_PORT=5173

# CORS (comma-separated list of origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="vantyx_user"
POSTGRES_PASSWORD="vantyx_password"
POSTGRES_DB="vantyx"
DATABASE_URL="postgresql+asyncpg://vantyx_user:vantyx_password@localhost:5432/vantyx"
DATABASE_SYNC_URL="postgresql://vantyx_user:vantyx_password@localhost:5432/vantyx"

# Optional Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Background Task Execution Mode
# inprocess: Local development on Windows without Redis or Docker (tasks execute in-process)
# distributed: Production / Docker environments using Redis message broker and Celery workers
TASK_EXECUTION_MODE="inprocess"
CELERY_ALWAYS_EAGER=true
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"
