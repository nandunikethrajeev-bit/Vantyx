# ==============================================================================
# VANTYX — Autonomous Media Intelligence Platform Environment Configuration
# ==============================================================================
# Copy this file to .env and configure for your environment.
# All sensitive credentials MUST use placeholders. Never commit real secrets.
# ==============================================================================

# --- Core Application ---
PROJECT_NAME="VANTYX"
ENVIRONMENT="development"  # development | staging | production
DEBUG=true
LOG_LEVEL="INFO"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production-min32chars"

# --- Token Encryption at Rest (Fernet: AES-128-CBC + HMAC-SHA256) ---
# Primary 32-byte urlsafe-base64 key. Generate using:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=""
# Comma-separated previous keys for seamless MultiFernet decryption during rotation:
TOKEN_ENCRYPTION_KEY_FALLBACKS=""

# --- API & Network Binding ---
API_V1_PREFIX="/api/v1"
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- Database Storage ---
# DB_DIALECT: auto (default: attempts PostgreSQL port 5432, falls back to SQLite) | postgresql | sqlite
DB_DIALECT="auto"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="vantyx_user"
POSTGRES_PASSWORD="vantyx_password"
POSTGRES_DB="vantyx"
# Custom Database URLs (leave blank to let VANTYX resolve automatically from dialect/paths)
DATABASE_URL=""
DATABASE_SYNC_URL=""
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# --- File Storage & Media Directories ---
DATA_DIR="./data"
MEDIA_DIR="./data/media"
EXPORT_DIR="./data/exports"
# Optional explicit path to ffmpeg binary (if None, resolves via imageio-ffmpeg or system PATH):
FFMPEG_PATH=""

# --- Creator Onboarding & Google OAuth ---
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
CREATOR_OAUTH_REDIRECT_URI="http://localhost:8000/api/v1/discovery/creators/oauth/callback"

# --- YouTube Publishing & Analytics ---
YOUTUBE_API_KEY=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:5173/distribution/oauth/callback"
# Set to true for offline local testing without hitting YouTube APIs:
MOCK_YOUTUBE_PUBLISHING=false
MOCK_YOUTUBE_ANALYTICS=true

# --- Multimodal Intelligence (Zero-Cost / Optional) ---
# Gemini API Key for semantic scene analysis (optional; heuristic fallback operates at zero cost):
GEMINI_API_KEY=""

# --- Channel & Production Settings ---
PRIMARY_CHANNEL_NAME="Astro Rebel"
TARGET_SHORTS_PER_DAY=4
TIMEZONE="Asia/Kolkata"
DEFAULT_PUBLISH_SLOTS="09:00,13:00,17:00,21:00"
MAX_CONCURRENT_RENDERS=2
WORKFLOW_RETRY_LIMIT=3

# --- Background Task Execution & Worker Settings ---
# inprocess: Local development on Windows without Redis/Docker (tasks execute in-process)
# distributed: Production / Docker environments using Redis message broker and Celery workers
TASK_EXECUTION_MODE="inprocess"
CELERY_ALWAYS_EAGER=true
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"
ORCHESTRATION_ENABLED=false
DAILY_PIPELINE_RUN_TIME="06:00"

# --- Feedback Engine ---
ANALYTICS_FEEDBACK_ENABLED=false
ANALYTICS_FEEDBACK_MAX_IMPACT=0.15
ANALYTICS_MIN_SAMPLE_SIZE=3
ANALYTICS_REPORTING_DELAY_HOURS=48
